# Copy to .env and adjust values.

PROMPTS_DIR=/qwarium/home/ext.arlatyshev/data/generated_prompts_py
PROMPTS_PATTERN=*.yaml
PROMPTS_MAX_DEPTH=1

WORK_ROOT=/Users/nident/Desktop/JOB/ScolTech/trae-agent/work
OUTPUT_DIR=/Users/nident/Desktop/JOB/ScolTech/trae-agent/answers

GIT_BASE_URL=https://github.com

# The command is executed from inside the isolated checkout.
# Available env vars:
#   REPO_DIR      absolute path to the checked-out repository
#   PROMPT_FILE  absolute path to the prompt text extracted from YAML
#   ANSWER_FILE  optional scratch answer file; script checks this first
TRAE_AGENT_CMD='trae-cli run --file "$PROMPT_FILE" --working-dir "$REPO_DIR" --console-type simple'

# Only these variables are passed into the isolated agent process.
AGENT_ENV_PASSTHROUGH='OPENAI_API_KEY OPENAI_BASE_URL ANTHROPIC_API_KEY ANTHROPIC_BASE_URL GOOGLE_API_KEY GOOGLE_BASE_URL OPENROUTER_API_KEY OPENROUTER_BASE_URL DOUBAO_API_KEY DOUBAO_BASE_URL TRAE_CONFIG_FILE LANG LC_ALL'

# Example with explicit provider/model:
# TRAE_AGENT_CMD='trae-cli run --file "$PROMPT_FILE" --working-dir "$REPO_DIR" --provider openai --model gpt-4o --console-type simple'

# Example if you run Trae Agent from a source checkout:
# TRAE_AGENT_CMD='uv run trae-cli run --file "$PROMPT_FILE" --working-dir "$REPO_DIR" --console-type simple'

# Optional Trae/model configuration.
CONFIG_FILE=/qwarium/home/ext.arlatyshev/trae_config.json
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=...
# OPENROUTER_API_KEY=...

PROMPTS_LIMIT=0
OUTPUT_COMMIT_LENGTH=40
OVERWRITE_OUTPUTS=false
VALIDATE_JSON=true
KEEP_FAILED_REPOS=false
STOP_ON_ERROR=false
DRY_RUN=false

PYTHON_BIN=python3
JQ_BIN=jq
